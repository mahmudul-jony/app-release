{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CentralizedVersionState",
  "type": "object",
  "required": ["version", "apps"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "apps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "app_id",
          "app_name",
          "repository",
          "package_name",
          "current_version_name",
          "current_build_number",
          "channels"
        ],
        "properties": {
          "app_id": { "type": "string" },
          "app_name": { "type": "string" },
          "repository": { "type": "string" },
          "package_name": { "type": "string" },
          "current_version_name": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "current_build_number": {
            "type": "integer",
            "minimum": 1
          },
          "flutter_version": { "type": "string" },
          "flutter_channel": { "type": "string" },
          "java_version": { "type": "string" },
          "updated_at": { "type": ["string", "null"] },
          "channels": {
            "type": "object",
            "required": ["production", "development"],
            "properties": {
              "production": {
                "type": "object",
                "properties": {
                  "channel": { "type": "string" },
                  "version_name": { "type": "string" },
                  "build_number": { "type": "integer" },
                  "release_tag": { "type": ["string", "null"] },
                  "apk_asset_name": { "type": ["string", "null"] },
                  "apk_download_url": { "type": ["string", "null"] },
                  "sha256_download_url": { "type": ["string", "null"] },
                  "commit_sha": { "type": ["string", "null"] },
                  "published_at": { "type": ["string", "null"] },
                  "run_id": { "type": ["string", "null"] }
                }
              },
              "development": {
                "type": "object",
                "properties": {
                  "channel": { "type": "string" },
                  "version_name": { "type": "string" },
                  "build_number": { "type": "integer" },
                  "release_tag": { "type": ["string", "null"] },
                  "apk_asset_name": { "type": ["string", "null"] },
                  "apk_download_url": { "type": ["string", "null"] },
                  "sha256_download_url": { "type": ["string", "null"] },
                  "commit_sha": { "type": ["string", "null"] },
                  "published_at": { "type": ["string", "null"] },
                  "run_id": { "type": ["string", "null"] }
                }
              }
            }
          },
          "active_reservation": {
            "type": ["object", "null"]
          },
          "reservations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "reservation_id",
                "run_id",
                "app_id",
                "channel",
                "branch",
                "version_name",
                "build_number",
                "status",
                "reserved_at"
              ],
              "properties": {
                "reservation_id": { "type": "string" },
                "run_id": { "type": "string" },
                "run_attempt": { "type": "integer" },
                "app_id": { "type": "string" },
                "channel": { "type": "string" },
                "is_prerelease": { "type": "boolean" },
                "branch": { "type": "string" },
                "version_name": { "type": "string" },
                "build_number": { "type": "integer" },
                "version_full": { "type": "string" },
                "release_tag": { "type": "string" },
                "release_title": { "type": "string" },
                "apk_asset_name": { "type": "string" },
                "metadata_asset_name": { "type": "string" },
                "commit_sha": { "type": ["string", "null"] },
                "reserved_at": { "type": "string" },
                "status": {
                  "type": "string",
                  "enum": ["reserved", "published", "failed", "cancelled"]
                },
                "updated_at": { "type": "string" }
              }
            }
          },
          "last_build": {
            "type": ["object", "null"],
            "properties": {
              "channel": { "type": ["string", "null"] },
              "branch": { "type": ["string", "null"] },
              "commit_sha": { "type": ["string", "null"] },
              "version_name": { "type": ["string", "null"] },
              "build_number": { "type": ["integer", "null"] },
              "release_tag": { "type": ["string", "null"] },
              "built_at": { "type": ["string", "null"] },
              "status": { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  }
}
